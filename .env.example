# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mono_e_mono?sslmode=disable

# Server
PORT=8080
ENV=development

# JWT
JWT_SECRET=your-256-bit-secret-at-least-32-chars-long

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
CALLBACK_BASE_URL=http://localhost:8080

# OAuth - Google (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (get from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis (for future use)
REDIS_URL=redis://localhost:6379
